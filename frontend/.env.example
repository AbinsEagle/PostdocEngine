# Frontend configuration (copy to .env to override defaults)

# Where the dev-server proxy forwards /api requests (backend origin)
VITE_API_TARGET=http://127.0.0.1:8000

# Optional: call the API on an absolute origin instead of the same-origin proxy.
# Leave unset to use the Vite proxy in dev / same-origin in production.
# VITE_API_URL=http://127.0.0.1:8000
