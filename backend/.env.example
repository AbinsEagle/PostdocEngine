# Backend configuration (copy to .env to override defaults)

# SQLite by default; point at Postgres for production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/postdocengine
DATABASE_URL=sqlite:///./postdocengine.db

# Comma-separated list of allowed CORS origins ("*" allows all)
CORS_ORIGINS=*

# Seed sample positions + a demo researcher on first startup
SEED_ON_STARTUP=true
